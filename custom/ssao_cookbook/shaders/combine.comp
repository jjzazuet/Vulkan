#version 450
// Cookbook SSAO combine, adapted from Chapter10/04_SSAO/src/combine.frag.
// Source: PacktPublishing/3D-Graphics-Rendering-Cookbook-Second-Edition
//         (MIT), commit 6777c3e.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D colorTex;
layout(set = 0, binding = 1) uniform sampler2D ssaoTex;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D outTex;

layout(push_constant) uniform Params {
  float scale;
  float bias;
} pc;

void main() {
  ivec2 size = imageSize(outTex);
  ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
  if (xy.x >= size.x || xy.y >= size.y) {
    return;
  }

  vec2 uv = (vec2(xy) + 0.5) / vec2(size);
  vec4 color = texture(colorTex, uv);
  float ssao = clamp(texture(ssaoTex, uv).r + pc.bias, 0.0, 1.0);
  vec3 outColor = mix(color.rgb, color.rgb * ssao, pc.scale);
  imageStore(outTex, xy, vec4(outColor, 1.0));
}
